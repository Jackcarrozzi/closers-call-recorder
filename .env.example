# ─── required ────────────────────────────────────────────────────────────────
# From the Discord developer portal: Bot -> Reset Token -> Copy.
DISCORD_TOKEN=

# Which voice channels to watch. A category name catches every voice channel
# inside it, including ones you add later. Comma-separated if you have several.
WATCH_CATEGORY_NAMES=Closers

# Text channel where "Recording started / saved" notices are posted.
# Run `npm run channels` to print every ID the bot can see.
LOG_CHANNEL_ID=

# ─── Google Drive ────────────────────────────────────────────────────────────
# Paste the whole token line that `rclone authorize "drive"` prints, including
# the braces. The container assembles the rclone config from it on boot.
GDRIVE_TOKEN=
RCLONE_REMOTE=gdrive:Discord Recordings

# ─── extra bots, for simultaneous calls ──────────────────────────────────────
# One bot can only sit in one voice channel per server. Add a second token to
# record two Closers calls at the same time, a third for three, and so on.
# DISCORD_TOKEN_2=
# DISCORD_TOKEN_3=

# ─── behaviour ───────────────────────────────────────────────────────────────
MIN_HUMANS=1              # 2 = only record actual conversations
LEAVE_GRACE_SEC=20        # someone can drop and rejoin without splitting the file
MIN_DURATION_SEC=20       # anything shorter is thrown away
MAX_SESSION_HOURS=6       # a marathon call becomes several parts
ANNOUNCE_START=true       # keep this on - see the consent note in the README
ANNOUNCE_END=true

# ─── output ──────────────────────────────────────────────────────────────────
AUDIO_BITRATE=64k
AUDIO_CHANNELS=1          # 1 = mono mixdown, 2 = stereo
KEEP_USER_TRACKS=false    # also keep each speaker's isolated track
DELETE_LOCAL_AFTER_UPLOAD=true
RETENTION_DAYS=14         # local copies only; 0 keeps them forever
TZ=America/New_York

# ─── transcripts (optional) ──────────────────────────────────────────────────
# off    - audio only (default)
# openai - ~$0.36 per hour of speech, needs OPENAI_API_KEY
# local  - free, runs whisper.cpp on the same box; needs a bigger container
TRANSCRIBE=off
# OPENAI_API_KEY=
