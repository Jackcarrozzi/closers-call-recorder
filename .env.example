# ─── required ────────────────────────────────────────────────────────────────
# Discord developer portal -> Bot -> Reset Token -> Copy.
DISCORD_TOKEN=

# Which voice channels to watch. A category name catches every voice channel
# inside it, including ones you add later. Comma-separated for several.
WATCH_CATEGORY_NAMES=Closers

# Text channel for "Recording started / saved" notices.
# Find IDs with: node list-channels.js
LOG_CHANNEL_ID=

# ─── Google Drive ────────────────────────────────────────────────────────────
# On a server you set this up interactively once:
#   sudo -u closersrec HOME=/var/lib/closers-recorder rclone config
# The service reads that config automatically, so nothing else is needed here.
RCLONE_REMOTE=gdrive:Discord Recordings

# Only needed in a container, where rclone can't run its browser step. Paste
# the whole token block that `rclone authorize "drive"` prints.
# GDRIVE_TOKEN=

# ─── extra bots, for simultaneous calls ──────────────────────────────────────
# One bot can only sit in one voice channel per server. Add a second token to
# record two Closers calls at once, a third for three, and so on.
# DISCORD_TOKEN_2=
# DISCORD_TOKEN_3=

# ─── behaviour ───────────────────────────────────────────────────────────────
MIN_HUMANS=1              # 2 = only record actual conversations
LEAVE_GRACE_SEC=20        # drop and rejoin without splitting the file
MIN_DURATION_SEC=20       # anything shorter is thrown away
MAX_SESSION_HOURS=6       # a marathon call becomes several parts
ANNOUNCE_START=true       # keep this on - see the consent note in the README
ANNOUNCE_END=true

# ─── output ──────────────────────────────────────────────────────────────────
AUDIO_BITRATE=64k
AUDIO_CHANNELS=1          # 1 = mono mixdown, 2 = stereo
KEEP_USER_TRACKS=false    # also keep each speaker's isolated track
DELETE_LOCAL_AFTER_UPLOAD=true
RETENTION_DAYS=14         # local copies only; 0 keeps them forever
TZ=America/New_York

# ─── transcripts ─────────────────────────────────────────────────────────────
# off    - audio only (default)
# local  - free, runs whisper.cpp on this box: sudo bash setup-whisper.sh
# openai - ~$0.36 per hour of speech, needs OPENAI_API_KEY
TRANSCRIBE=off
# OPENAI_API_KEY=
